# ═══════════════════════════════════════════════════════════════════════════
# 🔧 CONFIGURACIÓN DE LA APLICACIÓN
# ═══════════════════════════════════════════════════════════════════════════

# Entorno
NODE_ENV=production  # development, production, testing

# Puerto del servidor
PORT=3000

# URL base de la aplicación
APP_URL=http://localhost:3000
API_URL=http://localhost:3000/api

# ═══════════════════════════════════════════════════════════════════════════
# 📅 PROGRAMACIÓN Y AUTOMATIZACIÓN
# ═══════════════════════════════════════════════════════════════════════════

# Cantidad de posts a generar por día
POSTS_PER_DAY=3

# Hora de ejecución automática (formato 24h, ej: 06:00 para 6 AM)
SCHEDULE_TIME=06:00

# Timezone (ej: America/Bogota, Europe/Madrid, America/Mexico_City)
TIMEZONE=America/Mexico_City

# Expresión CRON para ejecución avanzada (sobrescribe SCHEDULE_TIME si está set)
# Ejemplos:
# 0 6 * * * = Diariamente a las 6 AM
# 0 */4 * * * = Cada 4 horas
# 0 6,12,18 * * * = A las 6 AM, 12 PM y 6 PM
CRON_EXPRESSION=0 6 * * *

# ═══════════════════════════════════════════════════════════════════════════
# 🎨 CONFIGURACIÓN DE CONTENIDO
# ═══════════════════════════════════════════════════════════════════════════

# Idioma de generación de contenido
CONTENT_LANGUAGE=es  # es, en, pt, fr

# Nicho específico
CONTENT_NICHE=veterinario  # veterinario, mascotas, medicina_animal

# Estilo de contenido
CONTENT_STYLE=educativo_entretenido  # educativo, entretenido, profesional, viral

# Tono de voz
TONE_OF_VOICE=amigable  # amigable, profesional, humorístico, serio

# Nivel de engagement objetivo
ENGAGEMENT_LEVEL=alto  # bajo, medio, alto

# ═══════════════════════════════════════════════════════════════════════════
# 🖼️ CONFIGURACIÓN DE IMÁGENES
# ═══════════════════════════════════════════════════════════════════════════

# Proveedor de imágenes
IMAGE_PROVIDER=openai  # openai (DALL-E), replicate (Stable Diffusion), unsplash, pexels

# Calidad de imagen (solo para DALL-E)
IMAGE_QUALITY=hd  # standard, hd

# Dimensiones por defecto (Instagram Reels)
IMAGE_WIDTH=1080
IMAGE_HEIGHT=1350

# Número de variaciones a generar
IMAGE_VARIATIONS=1

# ═══════════════════════════════════════════════════════════════════════════
# 🎬 CONFIGURACIÓN DE VIDEOS
# ═══════════════════════════════════════════════════════════════════════════

# Proveedor de videos
VIDEO_PROVIDER=ffmpeg  # ffmpeg, replicate, runway

# Duración de videos (segundos)
VIDEO_DURATION=18

# Resolución de video
VIDEO_RESOLUTION=1080p  # 720p, 1080p, 4k

# Velocidad de fotogramas (FPS)
VIDEO_FPS=30

# Música de fondo (URL o local)
VIDEO_MUSIC=default  # default, none, o URL de audio

# ═══════════════════════════════════════════════════════════════════════════
# 🔊 CONFIGURACIÓN DE AUDIO
# ═══════════════════════════════════════════════════════════════════════════

# Proveedor de síntesis de voz (Text-to-Speech)
TTS_PROVIDER=google  # google, amazon (Polly), azure, eleven_labs

# Voz (varía según proveedor)
TTS_VOICE=es-MX-Neural2-A  # Google Cloud TTS voice ID

# Velocidad de habla (0.5 - 2.0)
TTS_SPEED=1.0

# ═══════════════════════════════════════════════════════════════════════════
# 📊 CONFIGURACIÓN DE PUBLICACIÓN
# ═══════════════════════════════════════════════════════════════════════════

# Publicar automáticamente (true) o solo guardar como borrador (false)
AUTO_PUBLISH=false

# Retrasar publicación en minutos (para evitar spam)
PUBLISH_DELAY_MINUTES=5

# Hashtags a agregar automáticamente en cada post
DEFAULT_HASHTAGS=#VeterinariaTips #SaludDelPerro #MascotasFelices #ConsejosVeterinarios #DesdeVeterinaria

# Mencionar perfil veterinario al publicar (nombre de usuario)
MENTION_VETERINARY_ACCOUNT=@mi_veterinaria

# ═══════════════════════════════════════════════════════════════════════════
# 🔐 SEGURIDAD
# ═══════════════════════════════════════════════════════════════════════════

# JWT Secret para autenticación
JWT_SECRET=tu-secreto-super-seguro-aqui-cambialo-en-produccion

# Contraseña para admin panel (hasheada con bcrypt)
ADMIN_PASSWORD_HASH=$2b$10$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Limite de tasa (requests por minuto)
RATE_LIMIT=60

# ═══════════════════════════════════════════════════════════════════════════
# 📧 NOTIFICACIONES
# ═══════════════════════════════════════════════════════════════════════════

# Email para notificaciones
NOTIFICATION_EMAIL=tu@email.com

# Proveedor de email
EMAIL_PROVIDER=sendgrid  # sendgrid, mailgun, gmail, aws-ses

# SendGrid API Key (si usas SendGrid)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Gmail (si usas Gmail)
GMAIL_USER=tu-email@gmail.com
GMAIL_PASSWORD=tu-contraseña-app-gmail

# ═══════════════════════════════════════════════════════════════════════════
# 📈 ANALYTICS Y MONITOREO
# ═══════════════════════════════════════════════════════════════════════════

# Google Analytics
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Sentry para error tracking (https://sentry.io)
SENTRY_DSN=https://xxxxxxxx@xxxxxxxx.ingest.sentry.io/xxxxxxxx

# Logging level
LOG_LEVEL=info  # debug, info, warn, error

# ═══════════════════════════════════════════════════════════════════════════
# 💳 PAGOS Y SUSCRIPCIÓN
# ═══════════════════════════════════════════════════════════════════════════

# Stripe (para suscripciones) - https://stripe.com
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Precios de suscripción (IDs de Stripe)
STRIPE_BASIC_PRICE_ID=price_xxxxxxxxxxxxxxx
STRIPE_PRO_PRICE_ID=price_xxxxxxxxxxxxxxx
STRIPE_ENTERPRISE_PRICE_ID=price_xxxxxxxxxxxxxxx

# ═══════════════════════════════════════════════════════════════════════════
# 🌐 WEBHOOKS EXTERNOS
# ═══════════════════════════════════════════════════════════════════════════

# URL de webhook para notificaciones
WEBHOOK_URL=https://tu-dominio.com/webhooks/vet-content

# URL de webhook de Instagram (para sincronización de métricas)
INSTAGRAM_WEBHOOK_URL=https://tu-dominio.com/webhooks/instagram

# ═══════════════════════════════════════════════════════════════════════════
# 🚀 CARACTERÍSTICAS EXPERIMENTALES
# ═══════════════════════════════════════════════════════════════════════════

# Activar características beta
ENABLE_BETA_FEATURES=false

# Usar Claude 3.5 Sonnet (última versión)
USE_LATEST_CLAUDE_MODEL=true

# Caché de trending topics (en horas)
TRENDING_CACHE_DURATION=24

# ═══════════════════════════════════════════════════════════════════════════
# 📝 NOTAS DE CONFIGURACIÓN
# ═══════════════════════════════════════════════════════════════════════════

# 1. PASO CRÍTICO: Obtener ANTHROPIC_API_KEY
#    - Ir a https://console.anthropic.com
#    - Crear una cuenta o login
#    - Generar nueva API Key
#    - Copiar y pegar aquí

# 2. Para publicar en Instagram:
#    - Crear app en https://developers.facebook.com
#    - Agregar Instagram Graph API
#    - Generar Access Token
#    - Tener una cuenta de Instagram Business

# 3. Variables opcionales pero recomendadas:
#    - OPENAI_API_KEY para mejor generación de imágenes
#    - MONGODB_URI si quieres persistencia de datos

# 4. En producción, usar variables seguras (no en archivo .env)
#    - Environment variables en servidor
#    - Secrets manager de tu proveedor cloud

# ¡Listo! Tu configuración está completa. Guarda como .env y ejecuta:
# npm install
# npm start